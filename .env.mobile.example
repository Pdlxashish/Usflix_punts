# ── Mobile / Capacitor Build Environment ──────────────────────────────────────
# Copy this to .env.mobile and fill in your deployed backend URL.
# Then run: npm run cap:build (which uses this file automatically via the build script)
#
# This file is used when building the web assets that get bundled INTO the
# iOS / Android app. The app will call this URL directly (no Vite proxy).

# Your deployed backend URL — NO trailing slash
# Examples:
#   Railway:  https://your-app.up.railway.app
#   Render:   https://your-app.onrender.com
#   VPS:      https://api.yourdomain.com
VITE_API_URL=https://your-backend.up.railway.app
