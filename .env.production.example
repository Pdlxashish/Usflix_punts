# Production Frontend Environment Variables
# This file shows production-ready configuration
# Copy values to your deployment platform's environment configuration

# ===== REQUIRED: Clerk Authentication =====
VITE_CLERK_PUBLISHABLE_KEY=pk_live_your_publishable_key_here
CLERK_SECRET_KEY=sk_live_your_secret_key_here

# ===== REQUIRED FOR SPLIT DEPLOYMENTS =====
# Leave empty for same-origin deployments (Docker with nginx proxy)
# Set to your Render backend URL for Vercel + Render split deployments.
# Example: https://usflix-backend.onrender.com
VITE_API_URL=

# Optional: override the WebSocket URL. If omitted, the app derives it from VITE_API_URL.
# Example: wss://usflix-backend.onrender.com/ws
VITE_WS_URL=

# ===== OPTIONAL: Google OAuth =====
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ===== DEVELOPMENT ONLY - DO NOT SET IN PRODUCTION =====
# VITE_DEV_HTTPS should NOT be set in production builds
# VITE_DEV_HTTPS=false
