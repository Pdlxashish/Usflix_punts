# Frontend Environment Variables Template
# Copy this file to .env and fill in your actual values

# API Backend URL (build-time variable)
# Local dev: leave unset — Vite proxies /api to localhost:3001
# Docker/nginx same-origin: leave unset — nginx proxies /api
# Cloudflare Worker + separate API: https://api.your-domain.com
# Capacitor mobile builds: required — set to your public API URL
#
# VITE_API_URL=http://localhost:3001
