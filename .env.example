# Frontend Environment Variables Template
# Copy this file to .env and fill in your actual values

# API Backend URL
# Local development: http://localhost:3001
# Mobile testing: http://YOUR_COMPUTER_IP:3001 (e.g., http://192.168.1.100:3001)
# Frontend dev uses HTTPS on port 8080 (required for GPS/map on phones)
# Production: https://your-backend-api.com
# 
# To find your IP:
# - Windows: Run 'ipconfig' in Command Prompt
# - Mac/Linux: Run 'ifconfig' in Terminal
# - Look for IPv4 Address (usually starts with 192.168 or 10.0)
VITE_API_URL=http://localhost:3001
