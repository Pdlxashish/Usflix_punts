{
  "name": "memory-flix-for-us",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=20.19 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:api": "npm --prefix backend run dev",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:api": "npm --prefix backend run build",
    "build:all": "npm run build:api && npm run build",
    "verify": "npm run typecheck && npm run lint && npm run build:all",
    "deploy:worker": "npm run build && wrangler deploy",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "mobile-ip": "node scripts/get-local-ip.js",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "build:pwa": "vite build --config vite.mobile.config.ts",
    "generate:icons": "node scripts/generate-icons.mjs && node scripts/generate-splash.mjs",
    "cap:build": "npm run build:mobile && npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "cap:run:ios": "npx cap run ios",
    "cap:run:android": "npx cap run android",
    "doctor": "npx react-doctor@latest",
    "production:secrets": "node scripts/generate-jwt-secret.js"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.4.12",
