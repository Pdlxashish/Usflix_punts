# Backend Environment Variables Template
# Copy this file to .env and fill in your actual values

# PostgreSQL Database
# For local: postgresql://postgres:password@localhost:5432/usflix
# For production: Use your cloud database URL (Railway, Supabase, AWS RDS, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Authentication
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-key-minimum-32-characters-long
JWT_EXPIRES_IN=24h

# Initial admin account (only used when admin_users table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password-at-least-6-chars

# Rate limits: auto-OFF when NODE_ENV=development. Force on/off:
# DISABLE_RATE_LIMIT=true
# DISABLE_RATE_LIMIT=false

# Viewer profiles used for distance map (default: You + Me)
PARTNER_PROFILE_IDS=p1,p2

# OpenWeatherMap API Key
# Get your free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweathermap-api-key

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL(s) for CORS — comma-separated for multiple origins
# Local dev (GPS/map): https://localhost:8080
# Phone on Wi‑Fi: https://YOUR_LAN_IP:8080 (run: npm run mobile-ip)
# Production: https://your-domain.com
# Split deploy (Cloudflare + Railway): https://your-app.pages.dev,https://your-app.workers.dev
FRONTEND_URL=https://localhost:8080

# Cookie SameSite: strict (same-origin, default) | none (split frontend/API domains)
# COOKIE_SAME_SITE=none

# Demo seed data: auto-off in production. Force with SEED_DEMO_DATA=true|false
# SEED_DEMO_DATA=false

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=4294967296

# Cloud Storage (Optional - for production)
# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# Cloudflare R2 (Alternative to S3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Use cloud storage instead of local uploads (true/false)
USE_CLOUD_STORAGE=false
