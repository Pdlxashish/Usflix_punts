# Backend environment template
# Copy to backend/.env for local development. Never commit real secrets.

# Clerk Authentication (required)
# Get these from https://dashboard.clerk.com/ → API Keys
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# PostgreSQL
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/usflix

# Authentication
# Generate with: node ../scripts/generate-jwt-secret.js
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-characters
JWT_EXPIRES_IN=24h

# User JWT for Google authenticated users (generate a different secret)
USER_JWT_SECRET=replace-with-a-different-strong-random-secret-at-least-32-characters
USER_JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Initial admin account.
# In production ADMIN_PASSWORD must be at least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-development

# Server
PORT=3001
NODE_ENV=development

# CORS allow-list. Use comma-separated origins for multiple frontends.
FRONTEND_URL=http://localhost:8080,https://localhost:8080,http://localhost:5173,https://localhost:5173

# Cookie SameSite policy:
# - strict/lax for same-site deployments
# - none for split frontend/API domains over HTTPS
# COOKIE_SAME_SITE=none

# Rate limiting is enabled automatically in production.
# DISABLE_RATE_LIMIT=false

# Demo seed data is skipped automatically in production unless explicitly enabled.
# SEED_DEMO_DATA=false

# Optional weather integration.
OPENWEATHER_API_KEY=

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=4294967296

# Cloud storage configuration is reserved for future upload-route integration.
# Current production deploys that use local uploads need a persistent volume.
USE_CLOUD_STORAGE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
