# Backend Production Environment Variables
# This file shows production-ready configuration
# Copy values to your deployment platform's secret manager

# ===== REQUIRED: Clerk Authentication =====
CLERK_SECRET_KEY=sk_live_your_secret_key_here

# ===== REQUIRED: Database =====
# Use managed PostgreSQL service (Render Postgres, Supabase, Neon, Railway)
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/usflix?sslmode=require

# ===== REQUIRED: JWT Secrets =====
# Generate with: node ../scripts/generate-jwt-secret.js
# MUST be different from each other and from development secrets
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_EXPIRES_IN=24h
USER_JWT_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET_MIN_64_CHARS
USER_JWT_EXPIRES_IN=7d

# ===== REQUIRED: Admin Account =====
# CRITICAL: Use strong passwords (minimum 12 characters, mix of letters, numbers, symbols)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_12_CHARS

# ===== REQUIRED: Server Configuration =====
PORT=3001
NODE_ENV=production

# ===== REQUIRED: CORS Configuration =====
# Comma-separated list of allowed frontend origins
# Same-origin Docker: https://yourdomain.com
# Split Vercel + Render deployment: https://your-app.vercel.app,https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ===== COOKIE CONFIGURATION =====
# Use 'lax' for same-origin deployments (Docker with nginx)
# Use 'none' ONLY for split frontend/backend domains over HTTPS
COOKIE_SAME_SITE=lax

# ===== SECURITY =====
# Rate limiting (should always be enabled in production)
DISABLE_RATE_LIMIT=false

# Demo seed data (should never be enabled in production)
SEED_DEMO_DATA=false

# ===== OPTIONAL: Google OAuth =====
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ===== OPTIONAL: Weather Integration =====
OPENWEATHER_API_KEY=your_openweather_api_key

# ===== FILE UPLOADS =====
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=4294967296

# ===== CLOUD STORAGE (Future Feature) =====
# Current version uses local uploads with persistent volumes
# Cloud storage integration is reserved for future development
USE_CLOUD_STORAGE=false

# AWS S3 Configuration (if USE_CLOUD_STORAGE=true)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# Cloudflare R2 Configuration (if USE_CLOUD_STORAGE=true)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ===== MONITORING & LOGGING (Optional but Recommended) =====
# Sentry DSN for error tracking
# SENTRY_DSN=

# Log level (error, warn, info, debug)
# LOG_LEVEL=info
